---
import BaseLayout from '../layouts/BaseLayout.astro';

// Product screenshots are hidden until they are retaken from the current UI.
const showScreenshots = false;
---

<BaseLayout
  title="Platform — Tracepod"
  description="The Tracepod platform adds a web dashboard, an in-place validation pipeline, auto-fix, CVE delta reports, fleet policy, and more on top of the open-source toolchain."
>

  <!-- Hero -->
  <section class="platform-hero section">
    <div class="container">
      <div class="eyebrow">Platform</div>
      <h1 class="heading-xl platform-headline">
        Container hardening at fleet scale, tested on the workload it was built for.
      </h1>
      <p class="body-lg platform-sub">
        The Tracepod platform puts a dashboard, automated validation, and compliance tooling
        on top of the open-source hardening engine. It deploys into your cluster via Helm.
        Data is sent outside your cluster only to endpoints you configure, such as
        webhooks, and to the vulnerability-database feed used for CVE scanning. You see
        exactly what every workload has been hardened to, and whether the running workload
        touched anything the hardened image dropped.
      </p>
      <div style="display: flex; gap: 1.5rem; margin-top: 2rem; flex-wrap: wrap; align-items: center;">
        <a href="/contact?plan=free" class="btn btn-primary btn-lg">Request free Platform access</a>
        <a href="/contact?plan=pro" class="btn btn-secondary btn-lg">Discuss Pro</a>
        <a href="/open-source" class="hero-text-link">or start with open source &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Dashboard screenshot -->
  {showScreenshots && (
  <section class="screenshot-hero-section">
    <div class="container">
      <div class="screenshot-slot" role="img" aria-label="Tracepod dashboard overview">
        <img
          src="/screenshots/dashboard.png"
          alt="Tracepod dashboard overview with profiling, hardening, coverage and image-size totals, items needing attention, and recent activity"
          loading="lazy"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="screenshot-placeholder" style="display:none">
          <span>dashboard.png</span>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- Feature sections -->
  <section class="section">
    <div class="container">

      <!-- Feature: Dashboard -->
      <div class:list={['feature-block', { 'feature-block--text-only': !showScreenshots }]}>
        <div class="feature-block-text">
          <div class="eyebrow">Web dashboard</div>
          <h2 class="heading-md">CVE counts, size savings, and coverage for every workload in the cluster.</h2>
          <p class="body-md">
            The dashboard gives you a fleet-wide picture: which workloads have been profiled,
            hardened, tested, and promoted. See CVE counts, image size savings, and coverage
            scores at a glance. Drill down to individual builds to inspect the manifest,
            confidence scores, and pipeline results.
          </p>
          <ul class="feature-bullets">
            <li>Fleet summary with attention items (drift, blocked pipelines, missing coverage)</li>
            <li>Per-workload build history and lineage</li>
            <li>Live updates as builds and pipelines run</li>
            <li>Full audit log, exportable</li>
          </ul>
        </div>
        {showScreenshots && (
        <div class="feature-block-visual">
          <div class="screenshot-slot" role="img" aria-label="Tracepod workload detail view">
            <img
              src="/screenshots/workload-detail.png"
              alt="Tracepod workload detail page showing the coverage breakdown and the observed file manifest with the observation source of each path"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="screenshot-placeholder" style="display:none"><span>workload-detail.png</span></div>
          </div>
        </div>
        )}
      </div>

      <div class="feature-divider"></div>

      <!-- Feature: Validation in place -->
      <div class="feature-block feature-block--reversed">
        <div class="feature-block-text">
          <div class="eyebrow">Validation in place</div>
          <h2 class="heading-md">Test the hardened image where the workload actually runs.</h2>
          <p class="body-md">
            Tracepod tests a hardened image in the workload&rsquo;s own namespace, with its
            service account, secrets and network. It first watches the original pods for
            files the hardened image would be missing. In Pro, it then swaps the image on one
            pod, compares it with the rest, and rolls back on its own if that pod fails.
            When every stage passes, an Admin promotes the image to a new tag for your CD
            to deploy.
          </p>
          <ul class="feature-bullets">
            <li>Shadow: the sensor checks every file the running pods open against the hardened image</li>
            <li>Canary (Pro): one pod gets the hardened image and real traffic</li>
            <li>Rollout (Pro): more pods in steps, with automatic rollback on failure</li>
            <li>Promote: pushes a separate hardened tag and never overwrites the source tag</li>
            <li>Canary and rollout only run in namespaces you label <code>tracepod.io/pipeline=enabled</code>; Tracepod never edits your Deployment spec. Rollback evicts the hardened pods so they come back on the original image.</li>
          </ul>
        </div>
        <div class="feature-block-visual">
          <div class="mini-terminal terminal">
            <div class="terminal-bar">
              <div class="terminal-dot"></div>
              <div class="terminal-dot"></div>
              <div class="terminal-dot"></div>
              <span class="terminal-title">pipeline &middot; shop/checkout</span>
            </div>
            <div class="terminal-body pipeline-stages">
              <p><span class="stage-name">build</span><span class="output">hardened image built from the profile</span></p>
              <p><span class="stage-name">publish</span><span class="output">pushed to a staging tag</span></p>
              <p><span class="stage-name">shadow</span><span class="output">3d 4h observed &middot; 0 would&#8209;break</span></p>
              <p><span class="stage-name">canary</span><span class="output">1/6 pods &middot; ready &middot; 0 restarts</span><span class="stage-tier">Pro</span></p>
              <p><span class="stage-name">rollout</span><span class="output">25% &rarr; 50% &rarr; 100%</span><span class="stage-tier">Pro</span></p>
              <p><span class="stage-name">promote</span><span class="success">app:1.4.2-hardened (approved by admin)</span></p>
            </div>
          </div>
          <p class="stage-note">Free runs build, publish, shadow and promote. Pro adds canary and rollout on live pods.</p>
        </div>
      </div>

      <div class="feature-divider"></div>

      <!-- Feature: Auto-fix -->
      <div class="feature-block">
        <div class="feature-block-text">
          <div class="eyebrow">Auto-fix loop</div>
          <h2 class="heading-md">A missing file turns into a rebuild that includes it.</h2>
          <p class="body-md">
            When the pipeline sees a file the hardened image would be missing, auto-fix
            proposes a rebuild that includes exactly those paths and runs shadow again.
            It only adds paths that exist in the source image. In Free, an Operator starts
            each rebuild with one click. In Pro, the rebuild starts on its own, for up to
            three rounds by default. Every auto-fixed build records which build it repaired,
            and on which round. Webhooks fire when the loop finishes, whether it passes or fails.
          </p>
        </div>
        <div class="feature-block-visual">
          <div class="autofix-flow">
            <div class="flow-step flow-step--active">
              <span class="flow-step-num label">01</span>
              <span class="flow-step-label">Shadow</span>
              <span class="flow-step-result">watching pods</span>
            </div>
            <div class="flow-arrow">&#8594;</div>
            <div class="flow-step flow-step--active">
              <span class="flow-step-num label">02</span>
              <span class="flow-step-label">Would&#8209;break</span>
              <span class="flow-step-result flow-fail">2 paths missing</span>
            </div>
            <div class="flow-arrow">&#8594;</div>
            <div class="flow-step flow-step--active">
              <span class="flow-step-num label">03</span>
              <span class="flow-step-label">Rebuild</span>
              <span class="flow-step-result">+2 paths added</span>
            </div>
            <div class="flow-arrow">&#8594;</div>
            <div class="flow-step flow-step--pass">
              <span class="flow-step-num label">04</span>
              <span class="flow-step-label">Shadow</span>
              <span class="flow-step-result flow-pass">PASS</span>
            </div>
          </div>
        </div>
      </div>

      <div class="feature-divider"></div>

      <!-- Feature: CVE delta -->
      <div class:list={['feature-block', 'feature-block--reversed', { 'feature-block--text-only': !showScreenshots }]}>
        <div class="feature-block-text">
          <div class="eyebrow">CVE delta reports<span class="tier-pill">Pro</span></div>
          <h2 class="heading-md">See exactly how many vulnerabilities you removed.</h2>
          <p class="body-md">
            After each build, Tracepod runs grype against both the source and hardened images
            and computes the delta. CVE counts by severity are stored on the build record and
            surfaced in the dashboard.
          </p>
          <ul class="feature-bullets">
            <li>grype scan of source vs hardened image</li>
            <li>Counts broken down by severity</li>
            <li>Stored on the build record, queryable via API</li>
            <li>OpenVEX export with reachability for false-positive suppression</li>
          </ul>
        </div>
        {showScreenshots && (
        <div class="feature-block-visual">
          <div class="screenshot-slot" role="img" aria-label="CVE delta report">
            <img
              src="/screenshots/cve-delta.png"
              alt="CVE delta report showing reduction in critical and high severity vulnerabilities after hardening"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="screenshot-placeholder" style="display:none"><span>cve-delta.png</span></div>
          </div>
        </div>
        )}
      </div>

      <div class="feature-divider"></div>

      <!-- Feature: Fleet policy -->
      <div class="feature-block">
        <div class="feature-block-text">
          <div class="eyebrow">Fleet policy &amp; compliance<span class="tier-pill">Pro</span></div>
          <h2 class="heading-md">Define what &ldquo;hardened&rdquo; means per namespace, then see which workloads miss it.</h2>
          <p class="body-md">
            Define policies per namespace (glob-matched): minimum manifest coverage,
            hardened image required, validated required (the workload&rsquo;s current build
            completed the pipeline).
            The <code>/compliance</code> endpoint evaluates every workload against applicable
            policies and returns a pass/fail matrix you can gate deployments on or feed into
            GRC tooling.
          </p>
          <ul class="feature-bullets">
            <li>Namespace-glob scoped policies</li>
            <li>Min coverage, hardened-required, validated-required</li>
            <li>Fleet compliance report via <code>GET /api/v1/compliance</code></li>
            <li>RBAC-gated: Admin writes, Viewer reads</li>
          </ul>
        </div>
        <div class="feature-block-visual feature-cards-visual">
          <div class="mini-policy-cards">
            <div class="policy-card">
              <div class="policy-card-ns label">production/*</div>
              <div class="policy-row"><span>Min coverage</span><span class="policy-val">80%</span></div>
              <div class="policy-row"><span>Hardened required</span><span class="policy-check">&#10003;</span></div>
              <div class="policy-row"><span>Validated required</span><span class="policy-check">&#10003;</span></div>
            </div>
            <div class="policy-card">
              <div class="policy-card-ns label">staging/*</div>
              <div class="policy-row"><span>Min coverage</span><span class="policy-val">60%</span></div>
              <div class="policy-row"><span>Hardened required</span><span class="policy-check">&#10003;</span></div>
              <div class="policy-row"><span>Validated required</span><span class="policy-cross">&mdash;</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="feature-divider"></div>

      <!-- Feature grid: remaining features -->
      <div class="remaining-features">
        <h2 class="heading-md" style="text-align:center; margin-bottom:3rem;">Also in the platform</h2>
        <div class="remaining-grid">

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <h3>Promote to a hardened tag</h3>
            <p>Promote pushes the tested image to a separate tag (by default <code>&lt;source-tag&gt;-hardened</code>) for your CD to deploy. Admin role. The attention panel alerts when the running image differs from the promoted one.</p>
          </div>

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                <line x1="6" y1="1" x2="6" y2="4"/>
                <line x1="10" y1="1" x2="10" y2="4"/>
                <line x1="14" y1="1" x2="14" y2="4"/>
              </svg>
            </div>
            <h3>Webhooks + source-image watching<span class="tier-pill">Pro</span></h3>
            <p>Configure a <code>webhook_url</code> to receive build, pipeline, and autofix events as JSON. Source-image watching polls upstream digests and triggers auto-rebuild when they change.</p>
          </div>

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <h3>RBAC via Kubernetes TokenReview</h3>
            <p>No new identity system. Bearer tokens are validated by the K8s API server. Roles (Viewer, Operator, Admin) are set in a ConfigMap. Works with any OIDC-backed Kubernetes cluster.</p>
          </div>

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <h3>Append-only audit log</h3>
            <p>Every action (build, push, pipeline start, approve, promote, rollback, policy change) is recorded with user, timestamp, and structured metadata. Exportable as CSV or JSON.</p>
          </div>

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4M12 16h.01"/>
              </svg>
            </div>
            <h3>OpenVEX export with reachability<span class="tier-pill">Pro</span></h3>
            <p>Generate machine-readable VEX documents based on whether a vulnerable component is present in the minimised image. Suppresses false positives in scanner output.</p>
          </div>

          <div class="remaining-item card">
            <div class="remaining-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <h3>Registry management</h3>
            <p>Store target registry configs (host, repository path, tag strategy, TLS, K8s secret) in the platform. Test connectivity before saving. Support for anonymous and authenticated pushes.</p>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band section">
    <div class="container cta-band-inner">
      <div>
        <h2 class="heading-lg">Request a demo with one of your workloads.</h2>
        <p class="body-md" style="margin-top: 0.75rem;">
          We&rsquo;ll show you the hardened image, the CVE delta, and the pipeline run, live,
          on a workload like yours.
        </p>
      </div>
      <div class="cta-band-actions">
        <a href="/contact?plan=free" class="btn btn-primary btn-lg">Request free Platform access</a>
        <a href="/contact?plan=pro" class="btn btn-secondary btn-lg">Discuss Pro</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.platform-hero { padding-top: var(--space-16); }
.hero-text-link {
  color: var(--text-secondary);
  font-size: 0.95rem;
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  transition: color var(--transition);
}
.hero-text-link:hover { color: var(--accent); }
.platform-headline { max-width: 800px; margin-top: var(--space-4); }
.platform-sub { max-width: 640px; margin-top: var(--space-6); }
.btn-lg { padding: 0.8rem 1.75rem; font-size: 1rem; }

.screenshot-hero-section { padding-bottom: var(--space-8); }
.screenshot-slot {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  overflow: hidden;
  position: relative;
}
.screenshot-slot img {
  width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  display: block;
}
.screenshot-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.8rem;
}

.feature-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
  padding: var(--space-12) 0;
}
.feature-block--reversed .feature-block-text { order: 2; }
.feature-block--reversed .feature-block-visual { order: 1; }

.feature-block-text {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.feature-block-text code { font-family: var(--font-mono); color: var(--accent); font-size: 0.85em; }

.feature-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: 0;
}
.feature-bullets li {
  font-size: 0.9rem;
  color: var(--text-secondary);
  padding-left: 1.2rem;
  position: relative;
}
.feature-bullets li::before {
  content: '\2713';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-size: 0.8rem;
}

.feature-divider {
  height: 1px;
  background: var(--border-subtle);
}

/* Mini terminal */
.mini-terminal { width: 100%; }

/* Pipeline stages */
.pipeline-stages p {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}
.pipeline-stages .stage-name {
  color: var(--accent);
  min-width: 4.5rem;
  flex-shrink: 0;
}
.pipeline-stages .stage-tier {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 0.7rem;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: var(--radius-sm, 4px);
  padding: 0 0.4rem;
  line-height: 1.5;
}
.stage-note {
  margin-top: var(--space-3);
  font-size: 0.8rem;
  color: var(--text-secondary);
}
@media (max-width: 480px) {
  .pipeline-stages { overflow-x: auto; }
  .pipeline-stages p { white-space: nowrap; }
  .pipeline-stages .stage-tier { order: 1; margin-left: 0; }
  .pipeline-stages .output,
  .pipeline-stages .success { order: 2; }
}
.feature-block > .feature-block-text,
.feature-block > .feature-block-visual { min-width: 0; }
.feature-block--text-only { grid-template-columns: 1fr; }
.feature-block--text-only .feature-block-text { max-width: 720px; }

/* Autofix flow */
.autofix-flow {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
}
.flow-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  text-align: center;
}
.flow-step-num { font-size: 0.7rem; }
.flow-step-label { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); }
.flow-step-result { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); }
.flow-fail { color: #f85149; }
.flow-pass { color: #3fb950; font-weight: 600; }
.flow-arrow { color: var(--text-muted); font-size: 1.2rem; flex-shrink: 0; align-self: center; }

/* Policy cards */
.mini-policy-cards {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.policy-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.policy-card-ns { font-size: 0.75rem; margin-bottom: var(--space-1); }
.policy-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  color: var(--text-secondary);
}
.policy-val { color: var(--accent); font-family: var(--font-mono); font-weight: 600; }
.policy-check { color: #3fb950; font-weight: 600; }
.policy-cross { color: var(--text-muted); }

/* Remaining features */
.remaining-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}
.remaining-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.remaining-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--accent-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
}
.remaining-item h3 { font-size: 0.95rem; font-weight: 600; }
.remaining-item p { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; }
.remaining-item code { font-family: var(--font-mono); color: var(--accent); font-size: 0.85em; }

/* CTA band */
.cta-band { background: var(--bg-elevated); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.cta-band-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); }
.cta-band-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; flex-shrink: 0; }

@media (max-width: 960px) {
  .feature-block { grid-template-columns: 1fr; gap: var(--space-8); }
  .feature-block--reversed .feature-block-text { order: 1; }
  .feature-block--reversed .feature-block-visual { order: 2; }
  .remaining-grid { grid-template-columns: 1fr 1fr; }
  .autofix-flow { flex-direction: column; align-items: center; }
  .flow-arrow { transform: rotate(90deg); }
}
