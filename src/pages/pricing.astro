---
import BaseLayout from '../layouts/BaseLayout.astro';

const ossFeatures = [
  'eBPF sensor (DaemonSet) — profiles running containers by recording file opens, execs and dlopen loads, no kernel module',
  '`harden` CLI — builds minimized OCI images from a sensor profile, with recursive ELF dependency resolution',
  'Confidence scoring — a 0–100 coverage signal for every build, with the full penalty breakdown',
  'Removal manifest — the exact set of packages the hardening dropped, with file-level evidence',
  'CycloneDX and SPDX SBOM generation (via syft), with optional cosign signing',
  'Official Helm chart — DaemonSet, RBAC, values for kernel and runtime tuning',
  'GitHub Action — build, smoke-test, and SBOM a hardened image in CI',
  'Runtime presets for common language runtimes (e.g. Python)',
];

const freeFeatures = [
  'Web dashboard for your workloads',
  'Shadow verification — watches the running workload and lists any file the hardened image would be missing',
  'Promote the tested image to a new ‑hardened tag once shadow passes (Admin approval)',
  'Auto-fix suggestions — proposes a rebuild with the missing paths; you start it',
  'RBAC via Kubernetes TokenReview — no new identity system; roles set in a ConfigMap',
  'Append-only audit log — every action recorded, exportable as CSV or JSON',
  'Registry management — store and test target registry configs, anonymous or authenticated',
];

const proFeatures = [
  'Canary and rollout on live pods — swaps the image on one pod, then more, and rolls back automatically if they fail',
  'Unattended auto-fix (up to 3 rounds by default)',
  'CVE delta reports — grype scan of source vs. hardened image, stored on the build record',
  'OpenVEX export with reachability — based on whether a vulnerable component is present in the minimized image',
  'Fleet policy & compliance — namespace-scoped policies with a pass/fail compliance report',
  'Webhooks + source-image watching — build, pipeline and autofix events, and auto-rebuild on upstream digest changes',
];
---

<BaseLayout
  title="Pricing — Tracepod"
  description="The open-source core is free under AGPL-3.0. Tracepod Platform has a free tier with the dashboard and shadow verification, and a Pro tier that adds canary and rollout on live pods. Contact us for Pro pricing."
>
  <section class="pricing-hero section">
    <div class="container">
      <div class="eyebrow">Pricing</div>
      <h1 class="heading-xl">Pricing</h1>
      <p class="body-lg" style="margin-top: 1.5rem; max-width: 640px;">
        The open-source tools are free under AGPL-3.0. Tracepod Platform is in private
        beta. Platform Free costs nothing; contact us for Pro pricing.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="pricing-grid">

        <div class="pricing-card card">
          <div class="pricing-card-head">
            <div class="eyebrow">Core tools</div>
            <h2 class="heading-lg">Open source</h2>
            <p class="body-md">$0 &middot; AGPL-3.0. Self-hosted, in your own cluster.</p>
          </div>
          <ul class="pricing-features">
            {ossFeatures.map((f) => <li set:html={f.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}
          </ul>
          <div class="pricing-card-cta">
            <a href="/open-source" class="btn btn-secondary" style="width:100%; justify-content:center;">See Open Source</a>
          </div>
        </div>

        <div class="pricing-card card">
          <div class="pricing-card-head">
            <div class="eyebrow">Platform (Free)</div>
            <h2 class="heading-lg">Free</h2>
            <p class="body-md">Private beta. Deploys into your cluster via Helm. Builds, tests and promotes hardened images without touching your running pods. &ldquo;Access&rdquo; means we send you a registry token and a Helm chart to install.</p>
          </div>
          <p class="pricing-includes">Everything in Open Source, plus:</p>
          <ul class="pricing-features">
            {freeFeatures.map((f) => <li>{f}</li>)}
          </ul>
          <div class="pricing-card-cta">
            <a href="/contact?plan=free" class="btn btn-secondary" style="width:100%; justify-content:center;">Request free Platform access</a>
          </div>
        </div>

        <div class="pricing-card pricing-card--pro card">
          <div class="pricing-card-head">
            <div class="eyebrow">Platform (Pro)</div>
            <h2 class="heading-lg">Pro</h2>
            <p class="body-md">Private beta. Deploys into your cluster via Helm. Data is sent outside the cluster only to endpoints you configure, such as webhooks, and to the vulnerability-database feed used for CVE scanning.</p>
          </div>
          <p class="pricing-includes">Everything in Platform (Free), plus:</p>
          <ul class="pricing-features">
            {proFeatures.map((f) => <li>{f}</li>)}
          </ul>
          <div class="pricing-card-cta">
            <a href="/contact?plan=pro" class="btn btn-primary" style="width:100%; justify-content:center;">Discuss Pro</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="pricing-note card">
        <p class="body-md">
          Each tier includes everything in the one before it. All three run inside your
          own cluster. After you send the form, we reply by email with next steps: install
          instructions for Platform Free, or a call to scope Pro. See <a href="/compare">how Tracepod compares</a> to other tools,
          or read the <a href="/docs">docs</a> before you decide what you need.
        </p>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="pricing-note card">
        <h2 class="heading-lg">Which tier?</h2>
        <h3 class="which-q">What&rsquo;s the difference between the open-source core and the Platform?</h3>
        <p class="body-md">
          The open-source core (the eBPF sensor, the <code>harden</code> image builder, the Helm chart and
          the GitHub Action) is everything you need to profile a container and produce a hardened image
          and its SBOM, and it&rsquo;s free. The Platform adds a fleet dashboard, an in-place validation
          pipeline with automatic rollback, an auto-fix loop, CVE delta reports, fleet policy and more.
          The Platform has a Free tier and a Pro tier.
        </p>
        <h3 class="which-q">Can I promote a hardened image without testing it on live pods?</h3>
        <p class="body-md">
          Yes. Tracepod watches the running workload first and only lets you promote once it has seen
          nothing the hardened image would be missing. Testing on live pods (canary and rollout) is part
          of Pro. More answers are in the <a href="/faq">FAQ</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-band section">
    <div class="container cta-band-inner">
      <div>
        <h2 class="heading-lg">Not sure which you need?</h2>
        <p class="body-md" style="margin-top: 0.75rem;">
          Start with the open-source tools on one workload, and request Platform access when you want to roll it out across a fleet.
        </p>
      </div>
      <div class="cta-band-actions">
        <a href="/contact?plan=free" class="btn btn-primary btn-lg">Request free Platform access</a>
        <a href="/contact?plan=pro" class="btn btn-secondary btn-lg">Discuss Pro</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.pricing-hero { padding-top: var(--space-16); }

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  align-items: stretch;
}

.pricing-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}
.pricing-card--pro {
  border-color: var(--accent);
}

.pricing-card-head h2 { margin-top: var(--space-2); }
.pricing-card-head p { color: var(--text-secondary); margin-top: var(--space-2); font-size: 0.9rem; }

.pricing-features {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  list-style: none;
  padding: 0;
  margin: 0;
  flex: 1;
}
.pricing-features li {
  position: relative;
  padding-left: 1.4rem;
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
}
.pricing-features li::before {
  content: '\2713';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: 600;
}
.pricing-features code {
  font-family: var(--font-mono);
  color: var(--accent);
  font-size: 0.85em;
}

.pricing-includes {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.pricing-card-cta { margin-top: auto; padding-top: var(--space-4); }

.pricing-note { max-width: 760px; margin: 0 auto; }
.pricing-note p { color: var(--text-secondary); }
.which-q { font-size: 1rem; margin-top: var(--space-4); }

.cta-band { background: var(--bg-elevated); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.cta-band-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
.cta-band-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; flex-shrink: 0; }
.btn-lg { padding: 0.8rem 1.75rem; font-size: 1rem; }

@media (max-width: 1100px) {
  .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  .pricing-card--pro { grid-column: 1 / -1; }
}
@media (max-width: 760px) {
  .pricing-grid { grid-template-columns: 1fr; }
  .cta-band-inner { flex-direction: column; text-align: center; }
  .cta-band-actions { justify-content: center; }
}
@media (max-width: 480px) {
  .cta-band-actions { flex-direction: column; width: 100%; }
  .cta-band-actions .btn { justify-content: center; }
}
</style>
